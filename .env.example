# Окружение установки. Скопируйте в .env и правьте: install.sh делает это сам,
# если .env нет.
#
# Здесь только то, что отличает одну установку от другой: порты, реквизиты
# инфраструктуры и имя узла защиты. Адреса внутри сети compose заданы в
# compose/waf.yml по правилам docs/env.md и обычно не трогаются.

# --- Имя установки ---
# Имя проекта compose: под ним живут контейнеры, сети и тома. Одно на всю
# установку -- иначе шаг infra уходит в проект по имени каталога (compose),
# а шаг с компонентами -- в placitum из compose/waf.yml, и установщик
# перестаёт видеть собственную инфраструктуру.
COMPOSE_PROJECT_NAME=placitum

# --- Порты на хосте ---
# Узел защиты: сюда идёт клиентский трафик.
PLC_HTTP_PORT=80
PLC_HTTPS_PORT=443

# Панель для людей: сервер panel на узле защиты, вход через калитку -- список
# panel_users, в нём admin. Пароль install.sh спрашивает при установке и нигде не
# хранит; без терминала -- PLC_PANEL_PASSWORD в окружении запуска, не в этом файле.
# PLC_PANEL_BIND -- адрес IPv4 машины, на котором слушать: 127.0.0.1 -- только с
# неё самой (снаружи через ssh -L), адрес внутреннего интерфейса -- из его сети,
# 0.0.0.0 -- со всех адресов. Адрес обязан быть на машине, иначе docker не
# поднимет узел, а с ним и трафик. Фаервол хоста здесь не граница: опубликованные
# порты docker проводит мимо UFW, граница -- этот адрес.
PLC_PANEL_BIND=127.0.0.1
PLC_PANEL_PORT=8081

# API контроллера без калитки -- только на loopback: install.sh, e2e и
# аварийный вход, когда узел или калитка лежат.
PLC_CONTROLLER_PORT=8080

# --- Идентичность узла ---
# Имя ноды на шине и в журнале: по нему её видно в панели и в аудите.
PLC_NODE_ID=edge-01

# --- Куки калитки и капчи ---
# on -- кука ставится только по TLS. Пока узел отвечает по чистому HTTP,
# оставьте off, иначе браузер не отправит куку и вход не состоится.
PLC_COOKIE_SECURE=off

# --- Порты инфраструктуры ---
# none -- Postgres, Redis, NATS, ClickHouse и MinIO снаружи не видны (только
# сеть compose). loopback -- те же порты на 127.0.0.1 хоста: psql,
# clickhouse-client, консоль MinIO с самой машины.
PLC_INFRA_PORTS=none

# --- Реквизиты инфраструктуры ---
# Умолчания годятся для одиночной установки, где инфраструктура поднята этим
# же compose и наружу не торчит. Для внешних ClickHouse, Postgres или S3
# меняйте и адреса в compose/waf.yml -- см. docs/env.md.
POSTGRES_USER=waf
POSTGRES_PASSWORD=waf
POSTGRES_DB=waf

CLICKHOUSE_USER=waf
CLICKHOUSE_PASSWORD=waf

MINIO_ROOT_USER=waf
MINIO_ROOT_PASSWORD=wafwafwaf

# Уровень журнала сервера ClickHouse: warning, information, debug, trace.
CLICKHOUSE_LOG_LEVEL=warning

# --- Сборка ---
# Версия nginx, против исходников которой собирается модуль. Модуль, собранный
# против других исходников, даёт порчу памяти, а не ошибку загрузки, поэтому
# число общее для сборки модуля и базового образа.
NGINX_VERSION=1.28.0

# Версия и ревизия сборки, если их нужно задать руками: по умолчанию
# install.sh берёт тег и коммит core (dev и unknown вне git).
#PLC_VERSION=dev
#PLC_REVISION=unknown

# Пин отпечатка ключа контура для панели: сверка публичного ключа в браузере.
# install.sh проставляет его сам после генерации ключа.
VITE_CONTOUR_FINGERPRINT=
