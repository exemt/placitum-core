# Секреты установки: в git не лежат, белый список.
#
#   contour.key / contour.pub  пара ключа контура; приватный -- агентам и crypto
#   s3.creds                   реквизиты архива (aws_access_key_id/aws_secret_access_key)
#   auth.hmac, auth-app.hmac   ключи подписи калитки: сессии и удостоверение приложения
#   captcha.hmac, cookie.hmac  ключи подписи капчи и инспектора кук
#
# Заводит их ../bootstrap/secrets.sh, вызываемый из ../install.sh.
*
!.gitignore
