# Откуда установка берёт исходники компонентов.
#
# Значение -- контекст сборки docker: либо git-URL с ветвью или тегом
# (`...git#develop`, `...git#v1.2.0`), либо путь на диске. Compose передаёт его
# сборщику как есть, поэтому обе формы работают одинаково.
#
# Это же и есть манифест версий установки: зафиксировали тег -- получили
# воспроизводимую установку.
#
# Ветки компонента: `#develop` -- то, что разрабатывается, `#main` -- выкаченные
# сборки, `#v1.2.0` -- зафиксированный релиз. Пока продукт не выкачен ни разу,
# здесь стоит develop: в main у компонентов ещё пусто. Промышленная установка
# ставит теги, а не ветки.
#
# Пока компоненты живут в монорепозитории, а не в своих репозиториях,
# переопределите нужные строки путями:
#
#     PLC_SRC_LOGGER=../../logger
#     PLC_SRC_ACTION=../../inspectors/action
#
# и передайте файл установщику: ./install.sh install --sources sources.local.env

PLC_SRC_NGINX=https://github.com/exemt/placitum-nginx.git#develop
PLC_SRC_CONTROLLER=https://github.com/exemt/placitum-controller.git#develop
PLC_SRC_LOGGER=https://github.com/exemt/placitum-logger.git#develop
PLC_SRC_CRYPTO=https://github.com/exemt/placitum-crypto.git#develop
PLC_SRC_GEO=https://github.com/exemt/placitum-geo.git#develop
PLC_SRC_KEEPER=https://github.com/exemt/placitum-keeper.git#develop

PLC_SRC_IP=https://github.com/exemt/placitum-ip.git#develop
PLC_SRC_MODSEC=https://github.com/exemt/placitum-modsec.git#develop
PLC_SRC_JSON=https://github.com/exemt/placitum-json.git#develop
PLC_SRC_COUNTER=https://github.com/exemt/placitum-counter.git#develop
PLC_SRC_ACTION=https://github.com/exemt/placitum-action.git#develop
PLC_SRC_REWRITE=https://github.com/exemt/placitum-rewrite.git#develop

# Сайдкары наблюдения: пульс Redis и S3 на странице «Состояние».
PLC_SRC_REDIS_AGENT=https://github.com/exemt/placitum-redis-agent.git#develop
PLC_SRC_S3_AGENT=https://github.com/exemt/placitum-s3-agent.git#develop
