# Where component sources come from: a git URL with a branch or tag, or a path
# relative to compose/. Pin tags for a reproducible installation. To override a
# line, copy this file and run ./install.sh install --sources <copy>.

PLC_SRC_NGINX=https://github.com/exemt/placitum-node.git#develop
PLC_SRC_CONTROLLER=https://github.com/exemt/placitum-controller.git#develop
PLC_SRC_LOGGER=https://github.com/exemt/placitum-logger.git#develop
PLC_SRC_CRYPTO=https://github.com/exemt/placitum-crypto.git#develop
PLC_SRC_GEO=https://github.com/exemt/placitum-geo.git#develop
PLC_SRC_KEEPER=https://github.com/exemt/placitum-keeper.git#develop

PLC_SRC_IP=https://github.com/exemt/placitum-ip.git#develop
PLC_SRC_MODSEC=https://github.com/exemt/placitum-modsec.git#develop
PLC_SRC_JSON=https://github.com/exemt/placitum-json.git#develop
PLC_SRC_COUNTER=https://github.com/exemt/placitum-counter.git#develop
PLC_SRC_ACTION=https://github.com/exemt/placitum-action.git#develop
PLC_SRC_REWRITE=https://github.com/exemt/placitum-rewrite.git#develop
PLC_SRC_COOKIE=https://github.com/exemt/placitum-cookie.git#develop
PLC_SRC_AUTH=https://github.com/exemt/placitum-auth.git#develop
PLC_SRC_CAPTCHA=https://github.com/exemt/placitum-captcha.git#develop
# Text classifier; starts only with the vlai compose profile.
PLC_SRC_VLAI=https://github.com/exemt/placitum-vlai.git#develop

# Monitoring sidecars from one repository: the subdirectory follows the colon.
PLC_SRC_REDIS_AGENT=https://github.com/exemt/placitum-agents.git#develop:redis
PLC_SRC_S3_AGENT=https://github.com/exemt/placitum-agents.git#develop:s3
