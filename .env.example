# Installation settings. install.sh copies this file to .env on the first run.

# Compose project for containers, networks and volumes. Keep it the same for the
# whole installation, otherwise install.sh loses track of its own infrastructure.
COMPOSE_PROJECT_NAME=placitum

# Application traffic ports on the host.
PLC_HTTP_PORT=80
PLC_HTTPS_PORT=443

# Panel address and port on the host: 127.0.0.1 for this machine only (ssh -L from
# elsewhere), an interface address for its network, 0.0.0.0 for all addresses. The
# address must exist on the machine, otherwise the node does not start. Docker
# publishes ports around UFW, so this address is the only boundary. The admin
# password is asked by install.sh and never stored; without a terminal set
# PLC_PANEL_PASSWORD in the environment, not in this file.
PLC_PANEL_BIND=127.0.0.1
PLC_PANEL_PORT=8081

# Controller API without login, published on 127.0.0.1 only.
PLC_CONTROLLER_PORT=8080

# Node name in the panel, heartbeat and audit.
PLC_NODE_ID=edge-01

# on sends login gate and captcha cookies over TLS only. Keep off while the node
# serves plain HTTP, otherwise the browser drops the cookie and login fails.
PLC_COOKIE_SECURE=off

# Infrastructure ports: none keeps PostgreSQL, Redis, NATS, ClickHouse and MinIO
# inside the compose network; loopback publishes them on 127.0.0.1.
PLC_INFRA_PORTS=none

# Infrastructure credentials. For an external ClickHouse, PostgreSQL or S3 also
# change the addresses in compose/waf.yml.
POSTGRES_USER=waf
POSTGRES_PASSWORD=waf
POSTGRES_DB=waf

CLICKHOUSE_USER=waf
CLICKHOUSE_PASSWORD=waf

MINIO_ROOT_USER=waf
MINIO_ROOT_PASSWORD=wafwafwaf

# ClickHouse server log level: warning, information, debug, trace.
CLICKHOUSE_LOG_LEVEL=warning

# nginx version for the module build and the base image. A module built against
# other nginx sources corrupts memory instead of failing to load.
NGINX_VERSION=1.28.0

# Build version and revision; by default install.sh takes the core tag and commit.
#PLC_VERSION=dev
#PLC_REVISION=unknown

# Key fingerprint pinned in the panel; install.sh sets it after creating the key.
VITE_CONTOUR_FINGERPRINT=
