# Откуда установка берёт исходники компонентов.
#
# Значение -- контекст сборки docker: либо git-URL с ветвью или тегом
# (`...git#main`, `...git#v1.2.0`), либо путь на диске. Compose передаёт его
# сборщику как есть, поэтому обе формы работают одинаково.
#
# Это же и есть манифест версий установки: зафиксировали тег -- получили
# воспроизводимую установку. `#main` годится для стенда и пилота, для
# промышленной установки ставьте теги.
#
# Пока компоненты живут в монорепозитории, а не в своих репозиториях,
# переопределите нужные строки путями:
#
#     PLC_SRC_LOGGER=../../logger
#     PLC_SRC_ACTION=../../inspectors/action
#
# и передайте файл установщику: ./install.sh install --sources sources.local.env

PLC_SRC_NGINX=https://github.com/exemt/placitum-nginx.git#main
PLC_SRC_CONTROLLER=https://github.com/exemt/placitum-controller.git#main
PLC_SRC_LOGGER=https://github.com/exemt/placitum-logger.git#main
PLC_SRC_CRYPTO=https://github.com/exemt/placitum-crypto.git#main
PLC_SRC_GEO=https://github.com/exemt/placitum-geo.git#main
PLC_SRC_KEEPER=https://github.com/exemt/placitum-keeper.git#main

PLC_SRC_IP=https://github.com/exemt/placitum-ip.git#main
PLC_SRC_MODSEC=https://github.com/exemt/placitum-modsec.git#main
PLC_SRC_JSON=https://github.com/exemt/placitum-json.git#main
PLC_SRC_COUNTER=https://github.com/exemt/placitum-counter.git#main
PLC_SRC_ACTION=https://github.com/exemt/placitum-action.git#main
PLC_SRC_REWRITE=https://github.com/exemt/placitum-rewrite.git#main

# Сайдкары наблюдения: пульс Redis и S3 на странице «Состояние».
PLC_SRC_REDIS_AGENT=https://github.com/exemt/placitum-redis-agent.git#main
PLC_SRC_S3_AGENT=https://github.com/exemt/placitum-s3-agent.git#main
