<!--
  Собственные журналы ClickHouse: снять то, что никто не читает.

  Образ по умолчанию ведёт system.text_log, processors_profile_log, part_log,
  trace_log, metric_log и asynchronous_metric_log. На стенде 12.09 они держали
  десять гигабайт (text_log 4.4 ГБ, processors_profile_log 2 ГБ, query_log
  1.7 ГБ, part_log 1.5 ГБ) и сливались в фоне при каждой вставке журнала, а
  вставок тысячи в минуту. Читает их никто: журнал контура живёт в waf.log, а
  сервер сам пишет warning в консоль (logger.xml).

  Остаётся query_log со сроком в сутки: по нему видно, кто грузит базу. Свой
  engine системной таблице задавать нельзя рядом с partition_by (сервер не
  стартует, BAD_ARGUMENTS), поэтому срок задан отдельным ttl.
  Существующие таблицы этой правкой не удаляются, только перестают пополняться;
  снести хвост: DROP TABLE system.text_log (и остальные) один раз руками.

  Внимание: двойной дефис внутри XML-комментария запрещён, сервер с ним не
  стартует (SAXParseException). Тире здесь только длинное или никакое.
-->
<clickhouse>
    <text_log remove="1"/>
    <processors_profile_log remove="1"/>
    <part_log remove="1"/>
    <trace_log remove="1"/>
    <metric_log remove="1"/>
    <asynchronous_metric_log remove="1"/>
    <query_log>
        <database>system</database>
        <table>query_log</table>
        <partition_by>toYYYYMM(event_date)</partition_by>
        <ttl>event_date + INTERVAL 1 DAY DELETE</ttl>
        <flush_interval_milliseconds>7500</flush_interval_milliseconds>
    </query_log>
</clickhouse>
