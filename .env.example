# Installation settings. On the first run install.sh copies this file to .env, asks
# the node, port, panel and Redis settings on a terminal and writes new
# infrastructure passwords. ./install.sh reconfigure asks the settings again.

# Compose project for containers, networks and volumes. Keep it the same for the
# whole installation, otherwise install.sh loses track of its own infrastructure.
COMPOSE_PROJECT_NAME=placitum

# Application traffic ports on the host.
PLC_HTTP_PORT=80
PLC_HTTPS_PORT=443

# Panel address and port on the host: 127.0.0.1 for this machine only (ssh -L from
# elsewhere), an interface address for its network, 0.0.0.0 for all addresses. The
# address must exist on the machine, otherwise the node does not start. Docker
# publishes ports around UFW, so this address is the only boundary. The admin
# password is asked by install.sh and never stored; without a terminal set
# PLC_PANEL_PASSWORD in the environment, not in this file.
PLC_PANEL_BIND=127.0.0.1
PLC_PANEL_PORT=8081

# Controller API without login, published on 127.0.0.1 only.
PLC_CONTROLLER_PORT=8080

# Node name in the panel, heartbeat and audit.
PLC_NODE_ID=edge-01

# on sends login gate and captcha cookies over TLS only. Keep off while the node
# serves plain HTTP, otherwise the browser drops the cookie and login fails.
PLC_COOKIE_SECURE=off

# Infrastructure ports: none keeps PostgreSQL, Redis, NATS, ClickHouse and MinIO
# inside the compose network; loopback publishes them on 127.0.0.1.
PLC_INFRA_PORTS=none

# Infrastructure credentials; install.sh replaces the passwords with random ones
# when it creates .env. For an external ClickHouse, PostgreSQL or S3 also change the
# addresses in compose/waf.yml.
POSTGRES_USER=waf
POSTGRES_PASSWORD=waf
POSTGRES_DB=waf

CLICKHOUSE_USER=waf
CLICKHOUSE_PASSWORD=waf

MINIO_ROOT_USER=waf
MINIO_ROOT_PASSWORD=wafwafwaf

# Memory of the exchange Redis (request objects waiting for a verdict) and of the
# internal Redis (configuration and inspector state), MB; Redis keeps 80% for data.
# On a machine with 8 GB or less install.sh proposes 640 and 320.
PLC_REDIS_EXCHANGE_MB=2560
PLC_REDIS_INTERNAL_MB=512

# CPU cap per service, for the NATS bus and for keeper. install.sh lowers a cap to
# the number of cores: Docker refuses a bigger one. A node gets as many cores as nginx
# processes unless PLC_CPUS_EDGE says otherwise.
PLC_CPUS=2
PLC_CPUS_NATS=6
PLC_CPUS_KEEPER=4

# Protection nodes on this machine (each nginx with its agent; more than one puts haproxy in front
# of them on the traffic ports) and nginx processes per node, auto or a number.
PLC_NODES=1
PLC_NGINX_WORKERS=auto

# Copies of each inspector; 0 turns an inspector off and removes it from the catalog. The panel
# login needs auth. vlai is the text classifier: 4 GB more memory and a model download.
PLC_COPIES_IP=1
PLC_COPIES_MODSEC=1
PLC_COPIES_JSON=1
PLC_COPIES_COUNTER=1
PLC_COPIES_ACTION=1
PLC_COPIES_REWRITE=1
PLC_COPIES_COOKIE=1
PLC_COPIES_CAPTCHA=1
PLC_COPIES_AUTH=1
PLC_COPIES_VLAI=0

# ClickHouse server log level: warning, information, debug, trace.
CLICKHOUSE_LOG_LEVEL=warning

# nginx version for the module build and the base image, and the checksum of its
# tarball. A new version needs both values.
NGINX_VERSION=1.28.0
NGINX_SHA256=c6b5c6b086c0df9d3ca3ff5e084c1d0ef909e6038279c71c1c3e985f576ff76a

# Build version and revision; by default install.sh takes the core tag and commit.
#PLC_VERSION=dev
#PLC_REVISION=unknown
